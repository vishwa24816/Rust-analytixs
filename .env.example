LISTEN_ADDR=127.0.0.1:8000
DATABASE_URL=sqlite:./data/app.db?mode=rwc
RUST_LOG=rust_analytix=info,tower_http=info
APP_URL=http://127.0.0.1:8000
# empty = log mail instead of sending
SMTP_URL=
MAIL_FROM=Rust Analytix <hello@rust-analytix.local>
# empty = /oauth/google returns 400 "not configured"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 1 = paddle sandbox key + test prices
PADDLE_SANDBOX=
# 1 = block /register (private instance)
DISABLE_REGISTRATION=
# serving dirs (container defaults differ, see Containerfile)
TRACKER_DIR=tracker/js
PUBLIC_DIR=public
